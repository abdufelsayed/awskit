  "qcheck-alcotest" {with-test}
  "eio" {with-test}
  "eio_main" {with-test}
  "cohttp" {with-test}
  "cohttp-eio" {with-test}
  "ca-certs" {with-test}
  "domain-name" {with-test}
  "tls" {with-test}
  "tls-eio" {with-test}
