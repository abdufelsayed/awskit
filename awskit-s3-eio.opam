  "awskit-s3" {= version}
  "fmt"
  "eio"
  "ptime"
  "awskit-unix" {with-test & = version}
  "eio_main" {with-test}
  "digestif" {with-test}
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/abdufelsayed/awskit.git"
x-maintenance-intent: ["(latest)"]
