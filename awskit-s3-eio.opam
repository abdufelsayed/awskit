# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Eio adapter for Awskit S3"
description:
  "S3 client adapter over the Awskit Eio runtime with caller-owned HTTPS transport policy."
maintainer: ["Abdullah Elsayed <hey@abdufelsayed.dev>"]
authors: ["Abdullah Elsayed <hey@abdufelsayed.dev>"]
license: "MIT"
homepage: "https://github.com/abdufelsayed/awskit"
doc: "https://abdufelsayed.github.io/awskit/"
bug-reports: "https://github.com/abdufelsayed/awskit/issues"
depends: [
  "dune" {>= "3.22"}
  "ocaml" {>= "5.2"}
  "awskit" {= version}
  "awskit-eio" {= version}
  "awskit-s3" {= version}
  "fmt" {>= "0.11.0"}
  "eio" {>= "1.3"}
  "ptime"
  "cohttp-eio" {with-test & >= "6.2.1"}
  "eio_main" {with-test & >= "1.3"}
  "alcotest" {with-test & >= "1.9.1"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/abdufelsayed/awskit.git"
x-maintenance-intent: ["(latest)"]
