(test
 (name test_awskit_lwt)
 (package awskit-lwt)
 (libraries
  awskit
  awskit-lwt
  awskit_runtime_http_contract
  cohttp-lwt-unix
  ptime
  alcotest))

(rule
 (alias runtime-http-contract)
 (package awskit-lwt)
 (deps test_awskit_lwt.exe)
