(test
 (name test_awskit_s3_sim)
 (package awskit-s3-sim)
 (libraries
  awskit
  awskit-s3
  awskit-s3-sim
  awskit_s3_workload
  alcotest
  qcheck-core
  qcheck-alcotest
  ptime))

(rule
 (alias s3-sim-workload)
 (package awskit-s3-sim)
 (deps test_awskit_s3_sim.exe)
 (locks awskit-s3-sim-alcotest)
 (action
  (run ./test_awskit_s3_sim.exe test "workload:awskit-s3-sim:s3-state")))

(rule
 (alias s3-transfer-faults)
 (package awskit-s3-sim)
 (deps test_awskit_s3_sim.exe)
 (locks awskit-s3-sim-alcotest)
 (action
  (run
   ./test_awskit_s3_sim.exe
   test
   "workload:awskit-s3-sim:transfer-faults")))

(alias
 (name simulator-stateful-pbt)
 (package awskit-s3-sim)
 (deps
  (alias s3-sim-workload)))

(rule
 (alias discovery)
 (package awskit-s3-sim)
 (deps test_awskit_s3_sim.exe)
 (locks awskit-s3-sim-alcotest)
 (action
  (run ./test_awskit_s3_sim.exe test "workload:awskit-s3-sim:")))
