(rule
 (alias observability-contracts)
 (deps
  (alias interfaces/observability-interface-contracts)
  test_observation_engine.exe
  test_observer_lwt.exe
  test_observer_eio.exe
  test_metrics_projection.exe
  test_trace_lwt_projection.exe
  test_trace_eio_projection.exe
  test_opentelemetry_lwt_projection.exe
  test_transfer_observation_lwt.exe
  test_transfer_observation_eio.exe)
 (action
  (progn
   (run ./test_observation_engine.exe)
   (run ./test_observer_lwt.exe)
   (run ./test_observer_eio.exe)
   (run ./test_metrics_projection.exe)
   (run ./test_trace_lwt_projection.exe)
   (run ./test_trace_eio_projection.exe)
   (run ./test_opentelemetry_lwt_projection.exe)
   (setenv
    AWSKIT_RUNTIME_HTTP_REQUIRE_LOOPBACK
    1
    (progn
     (run ./test_transfer_observation_lwt.exe)
     (run ./test_transfer_observation_eio.exe))))))
