opam-version: "2.0"
synopsis:
  "S3 client — objects, buckets, multipart, policies, and simulation"
description:
  "S3 operations, bucket configuration, multipart uploads, presigned URLs, policies, simulation, and XML wire types. Eio, generic Lwt, and Lwt + Unix adapters are available as separate sub-libraries."
maintainer: ["Abdullah Elsayed <hey@abdufelsayed.dev>"]
authors: ["Abdullah Elsayed <hey@abdufelsayed.dev>"]
license: "MIT"
homepage: "https://github.com/weldr-ai/awskit"
bug-reports: "https://github.com/weldr-ai/awskit/issues"
depends: [
  "dune" {>= "3.22"}
  "ocaml"
  "awskit"
  "base"
  "digestif"
  "ptime"
  "fmt"
  "logs"
  "yojson"
  "base64"
  "uri"
  "ezxmlm"
  "ppx_protocol_conv_xmlm"
  "ppx_deriving"
  "ppx_yojson_conv"
  "alcotest" {with-test}
  "qcheck-core" {with-test}
  "qcheck-alcotest" {with-test}
  "eio_main" {with-test}
  "cohttp-eio" {with-test}
  "lwt" {with-test}
  "cohttp-lwt-unix" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/weldr-ai/awskit.git"
x-maintenance-intent: ["(latest)"]
