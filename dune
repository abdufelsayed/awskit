(alias
 (name check-protocol)
 (package awskit)
 (deps
  (alias_rec protocol-pbt)))

; Keep package-filtered @check-protocol usable for packages whose protocol
; evidence is covered by another package-specific gate.

(alias
 (name check-protocol)
 (package awskit-unix)
 (deps dune-project))

(alias
