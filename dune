(dirs :standard \ test.o)

(alias
 (name check-fast)
 (deps
  (alias_rec runtest)
  (alias_rec examples)))

(alias
 (name check-local)
 (deps
  dune-project
  (alias runtime-http-workload)
  (alias s3-sim-workload)))

(alias
 (name check-docker)
 (deps dune-project))

(alias
 (name check-discovery)
 (deps dune-project))

; Compatibility aliases stay usable while the test tree is rebuilt. Focused
; workload passes replace these no-op deps with the aliases they introduce.

(alias
 (name runtime-http-workload)
 (deps
  (alias test/awskit/eio/runtime-http-workload)
  (alias test/awskit/lwt/runtime-http-workload)))

(alias
 (name runtime-conformance)
 (deps
  (alias runtime-http-workload)))

(alias
 (name s3-sim-workload)
 (deps
  (alias test/awskit-s3/sim/s3-sim-workload)))

